# Copy to .env and fill in. Never commit .env.
# All FINSIGHT_* variables are read by the backend only (backend/app/core/config.py).

# --- Docker Compose PostgreSQL ---
POSTGRES_USER=finsight
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finsight

# --- Backend ---
FINSIGHT_ENVIRONMENT=development
# Used when running the backend outside Docker (e.g. uvicorn on the host):
FINSIGHT_DATABASE_URL=postgresql+psycopg://finsight:change-me@localhost:5432/finsight
FINSIGHT_LOG_LEVEL=INFO
FINSIGHT_LOG_JSON=true
FINSIGHT_CORS_ORIGINS=http://localhost:5173

# Auth: at least 32 random characters; REQUIRED when FINSIGHT_ENVIRONMENT=production.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FINSIGHT_JWT_SECRET=
FINSIGHT_ACCESS_TOKEN_TTL_MINUTES=60

# Rate limits (per process)
FINSIGHT_RATE_LIMIT_AUTH_PER_MINUTE=10
FINSIGHT_RATE_LIMIT_COMPUTE_PER_MINUTE=60
FINSIGHT_RATE_LIMIT_INGEST_PER_HOUR=20

FINSIGHT_RATE_LIMIT_MARKET_DATA_PER_MINUTE=120

# --- Market data (India-first, free sources only; no keys required) ---
FINSIGHT_DEFAULT_MARKET=IN
# demo = synthetic offline data (default); tej = free keyless Tej API (NSE/BSE end-of-day)
FINSIGHT_MARKET_DATA_PROVIDER=demo
# demo | yfinance (optional extra, unofficial, Yahoo terms: personal use only) | none
FINSIGHT_FUNDAMENTALS_PROVIDER=demo
FINSIGHT_MARKET_DATA_TIMEOUT_SECONDS=15
FINSIGHT_MARKET_DATA_CACHE_TTL_SECONDS=900
FINSIGHT_MARKET_DATA_STALE_AFTER_DAYS=4

# Optional US market. SEC EDGAR requires a descriptive User-Agent with contact info; ingestion is disabled until set.
# e.g. FINSIGHT_SEC_USER_AGENT=FinSight you@example.com
FINSIGHT_SEC_USER_AGENT=

# Reserved for Phase 5. Backend-only; never expose to the frontend.
FINSIGHT_ANTHROPIC_API_KEY=
